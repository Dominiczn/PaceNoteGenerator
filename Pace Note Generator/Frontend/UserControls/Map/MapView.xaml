<UserControl x:Class="Pace_Note_Generator.Frontend.UserControls.Map.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pace_Note_Generator.Frontend.UserControls.Map"
             xmlns:userControls="clr-namespace:Pace_Note_Generator.Frontend.UserControls.Map"
             xmlns:gmap="clr-namespace:GMap.NET.WindowsPresentation;assembly=GMap.NET.WindowsPresentation"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <gmap:GMapControl x:Name="MapControl"/>

        <Border Background="#141414"
                BorderBrush="#E2001A" BorderThickness="2"
                Height="Auto" Width="300" 
                VerticalAlignment="Top" HorizontalAlignment="Left">
            <StackPanel x:Name="StcPnlButtonsHolder">
                <userControls:MapButtons x:Name="MapButtonsPanel"/>
                <userControls:MarkerCoordinates/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
