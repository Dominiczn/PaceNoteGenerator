<UserControl x:Class="Pace_Note_Generator.Frontend.UserControls.Map.MapButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pace_Note_Generator.Frontend.UserControls.Map"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">
    <Grid>
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="50*"/>
                    </Grid.ColumnDefinitions>

                    <!--Add Checkpoint Button-->
                    <Border Grid.Column="1" CornerRadius="20" BorderThickness="1" BorderBrush="#FEFBFB" Background="#141414" Width="75" Margin="5" Style="{StaticResource LowerBorderOpacity}">
                        <Button Name="BtnAddCheckpoint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Padding="0,-14,0,14"
                                Content="+" 
                                Height="50" Width="75" 
                                Background="Transparent" Foreground="White"
                                BorderBrush="Transparent" 
                                FontFamily="Segoe UI"
                                FontSize="50"
                                Style="{StaticResource NoBlueButton}"
                                Click="BtnAddCheckpoint_Click"/>
                    </Border>


                    <!--Remove Checkpoint Button-->
                    <Border Grid.Column="0" CornerRadius="20" BorderThickness="1" BorderBrush="#FEFBFB" Background="#141414" Width="75" Margin="5" Style="{StaticResource LowerBorderOpacity}">
                        <Button Name="BtnRemoveCheckpoint"
                                HorizontalAlignment="Center"
                                Padding="0,-14,0,14"
                                Content="-" 
                                Height="50" Width="75" 
                                Background="Transparent" Foreground="White"
                                BorderBrush="Transparent" 
                                FontFamily="Segoe UI"
                                FontSize="50"
                                Style="{StaticResource NoBlueButton}"
                                Click="BtnRemoveCheckpoint_Click"/>
                    </Border>
                </Grid>

                <!--Calculate Route button-->
                <Border Grid.Row="1" CornerRadius="20" Background="#E2001A" Width ="150" Margin="5" Style="{StaticResource LowerBorderOpacity}">
                    <Button Name="BtnCalculateRoute"
                            Content="Calculate Route" 
                            Height="50" Width="150" 
                            Background="Transparent" Foreground="White"
                            BorderBrush="Transparent" 
                            FontFamily="Segoe UI"
                            FontSize="15"
                            Style="{StaticResource NoBlueButton}"
                            Click="BtnCalculateRoute_Click"/>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
