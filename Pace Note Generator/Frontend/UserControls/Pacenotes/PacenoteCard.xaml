<UserControl x:Class="Pace_Note_Generator.Frontend.UserControls.Pacenotes.PacenoteCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pace_Note_Generator.Frontend.UserControls.Pacenotes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="700">
    <Viewbox>
        <Grid Width="700" Height="700">
            <Image Source="/Frontend/UserControls/Images/Straight.png" x:Name="ImgStraightBorder"/>
            <TextBlock x:Name="TxtStraight"
                       Background="Transparent"
                       Foreground="#fefbfb"
                       FontFamily="Bahnschrift SemiCondensed"
                       FontWeight="Bold"
                       FontSize="500"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,62,0,0"/>

            <Image x:Name="ImgCorner"/>
        </Grid>
    </Viewbox>
</UserControl>
