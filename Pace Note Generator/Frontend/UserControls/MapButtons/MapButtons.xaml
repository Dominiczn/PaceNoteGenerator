<UserControl x:Class="Pace_Note_Generator.Frontend.UserControls.MapButtons.MapButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pace_Note_Generator.Frontend.UserControls.MapButtons"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!--Add Checkpoint Button-->
                <Border Grid.Row="1" CornerRadius="20" BorderThickness="1" BorderBrush="#FEFBFB" Background="#141414" Width ="150" Margin="5" Style="{StaticResource LowerBorderOpacity}">
                    <Button Name="BtnAddCheckpoint"
                            Content="Add Checkpoint" 
                            Height="50" Width="150" 
                            Background="Transparent" Foreground="White"
                            BorderBrush="Transparent" 
                            FontFamily="Segoe UI"
                            FontSize="15"
                            Style="{StaticResource NoBlueButton}"
                            Click="BtnAddCheckpoint_Click"/>
                </Border>

                <Button Grid.Row="2"
                        Content="Calculate Route"/>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
